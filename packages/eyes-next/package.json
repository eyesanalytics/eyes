{
    "name": "eyes-next",
    "version": "0.5.1",
    "description": "Eyes Analytics: Next.js integration with automatic proxying",
    "author": "Pixel Perfect Agency B.V.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eyesanalytics/eyes.git",
        "directory": "packages/eyes-next"
    },
    "homepage": "https://eyes.dev",
    "bugs": {
        "email": "support@eyes.dev"
    },
    "keywords": [
        "analytics",
        "nextjs",
        "next",
        "tracking",
        "proxy",
        "web-analytics",
        "product-analytics",
        "privacy",
        "cookieless",
        "gdpr"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.mts",
                "require": "./dist/index.d.cts"
            },
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./config": {
            "types": {
                "import": "./dist/config.d.mts",
                "require": "./dist/config.d.cts"
            },
            "import": "./dist/config.mjs",
            "require": "./dist/config.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsdown",
        "prepublishOnly": "pnpm run build",
        "dev": "tsdown --watch",
        "lint": "biome check src tsconfig.json vitest.config.ts tsdown.config.ts",
        "lint:fix": "biome check --write src tsconfig.json vitest.config.ts tsdown.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "eyes-react": "workspace:*"
    },
    "peerDependencies": {
        "next": ">=14",
        "react": ">=18"
    },
    "devDependencies": {
        "@eyes/typescript-config": "workspace:*",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "next": "16.4.6",
        "react": "19.3.1",
        "tsdown": "^0.21.8",
        "typescript": "^7.0.2",
        "vitest": "^4.0.0"
    }
}
