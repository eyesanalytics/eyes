{
    "extends": "@eyes/typescript-config/base.json",
    "compilerOptions": {
        "types": ["node"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "isolatedDeclarations": true,
        "paths": {
            "~/*": ["./src/*"]
        },
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
