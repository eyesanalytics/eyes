{
    "name": "@eyes/track",
    "version": "0.1.0",
    "private": true,
    "description": "Eyes Analytics: lightweight client-side tracker",
    "author": "Pixel Perfect Agency B.V.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eyesanalytics/eyes.git",
        "directory": "packages/track"
    },
    "keywords": [
        "analytics",
        "tracking",
        "web-vitals",
        "pageview",
        "events"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.mts",
                "require": "./dist/index.d.cts"
            },
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./script": "./dist/index.iife.js",
        "./global": "./src/global.d.ts"
    },
    "files": [
        "dist",
        "src/global.d.ts"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint": "biome check src tsconfig.json vitest.config.ts tsdown.config.ts",
        "lint:fix": "biome check --write src tsconfig.json vitest.config.ts tsdown.config.ts",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "eyes-types": "workspace:*"
    },
    "devDependencies": {
        "@eyes/typescript-config": "workspace:*",
        "@types/bun": "^1.3.14",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "^5.0.0",
        "happy-dom": "^21.0.0",
        "tsdown": "^0.21.8",
        "typescript": "^7.0.2",
        "vitest": "^4.0.0"
    }
}
