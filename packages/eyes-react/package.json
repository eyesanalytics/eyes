{
    "name": "eyes-react",
    "version": "0.3.1",
    "description": "Eyes Analytics: React provider and hook",
    "author": "Pixel Perfect Agency",
    "license": "MIT",
    "keywords": [
        "analytics",
        "react",
        "tracking",
        "provider",
        "hook"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.mts",
                "require": "./dist/index.d.cts"
            },
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsdown",
        "prepublishOnly": "pnpm run build",
        "dev": "tsdown --watch",
        "lint": "biome check src tsconfig.json vitest.config.ts tsdown.config.ts",
        "lint:fix": "biome check --write src tsconfig.json vitest.config.ts tsdown.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "eyes-types": "workspace:*"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@eyes/typescript-config": "workspace:*",
        "@types/react": "19.2.14",
        "@types/react-dom": "^19.2.3",
        "happy-dom": "^20.14.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tsdown": "^0.21.8",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4"
    }
}
